{
  "name": "translate-it",
  "version": "1.25.2",
  "type": "module",
  "description": "Translator for selected text, web pages, PDFs, subtitles, images, and live dubbing, with traditional and AI providers.",
  "scripts": {
    "build": "node scripts/build/build-all.mjs --parallel",
    "build:sequential": "node scripts/build/build-all.mjs",
    "build:chrome": "node scripts/build/build-chrome.mjs",
    "build:firefox": "node scripts/build/build-firefox.mjs",
    "watch:chrome": "node scripts/dev/watch.mjs chrome",
    "watch:firefox": "node scripts/dev/watch.mjs firefox",
    "dev:chrome": "cross-env NODE_ENV=development vite build --config config/vite/vite.config.chrome.js",
    "dev:firefox": "cross-env NODE_ENV=development vite build --config config/vite/vite.config.firefox.js",
    "dev:android": "node scripts/dev/android-runner.mjs --build",
    "watch:android": "node scripts/dev/android-runner.mjs",
    "lint": "eslint",
    "lint:styles": "stylelint \"src/assets/styles/**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"src/assets/styles/**/*.{css,scss}\" --fix",
    "format": "node scripts/dev/format.mjs",
    "validate": "node scripts/validate/validate-all.mjs",
    "validate:chrome": "node scripts/validate/validate-chrome.mjs",
    "validate:firefox": "node scripts/validate/validate-firefox.mjs",
    "validate:production-bundle": "node scripts/validate/validate-production-bundle.mjs",
    "publish": "pnpm run build && pnpm run validate && pnpm run source",
    "pre-submit": "pnpm run lint && pnpm run lint:styles && pnpm run build",
    "source": "node scripts/dev/create-source-zip.mjs",
    "setup": "node scripts/setup/setup.cjs",
    "setup:chrome-validator": "pnpm add -D web-ext",
    "i18n:sync:status": "node scripts/localization/sync-i18n.cjs",
    "i18n:sync:fix": "node scripts/localization/sync-i18n.cjs --fix",
    "i18n:validate": "node scripts/localization/validate-i18n.cjs",
    "i18n:check": "node scripts/localization/check-i18n.cjs",
    "i18n:check:fix": "node scripts/localization/check-i18n.cjs --remove",
    "i18n:purge": "node scripts/localization/purge-notes.cjs",
    "analyze": "node scripts/dev/analyze-bundles.js",
    "perf:monitor": "node scripts/dev/performance-monitor.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "addons-linter": "^10.14.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-vue": "^9.33.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.6.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.2",
    "sass-embedded": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "terser": "^5.51.2",
    "vite": "^8.3.4",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.14",
    "web-ext": "^10.8.0",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "archiver": "^8.0.0",
    "chalk": "^6.0.1",
    "core-js": "^3.50.0",
    "deepl-node": "^1.28.1",
    "dompurify": "^3.4.17",
    "domtranslator": "^1.3.1",
    "glob": "^13.0.6",
    "marked": "^18.1.1",
    "pdfjs-dist": "6.4.299",
    "pinia": "^4.1.0",
    "regenerator-runtime": "^0.14.1",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "webextension-polyfill": "^0.12.0",
    "xss": "^1.0.15"
  },
  "packageManager": "pnpm@12.11.2"
}
